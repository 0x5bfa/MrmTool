<Application
    x:Class="MrmTool.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MrmTool">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Resources/Colors.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/ControlTemplates.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/WCT/GridSplitter.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/WCT/SizerBase.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/WCT/DataColumn.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/Uno/TreeView_themeresources.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/Uno/TreeViewItem.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/Uno/TreeView.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/Uno/MenuBar/MenuBar_themeresources.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/Uno/MenuBar/MenuBarItem.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/Uno/MenuBar/MenuBar.xaml" />
                <ResourceDictionary Source="ms-appx:///Resources/Uno/RadioMenuFlyoutItem/RadioMenuFlyoutItem.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Frame">
                <Setter Property="Background" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
